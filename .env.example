# Базовый URL для ссылок в письмах (confirm/unsubscribe).
# Прод: https://www.makilove.de · локально можно http://localhost:3000
SITE_URL=https://www.makilove.de

# --- Mail: SMTP Private Email (основной путь) --------------------------------
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=makilove@hotel-weisses-haus.com   # он же отправитель (From)
SMTP_PASS=                   # пароль ящика — только в .env.local и Vercel
# --- Mail: Brevo (запасной путь, только если SMTP_* не заданы) --------------
BREVO_API_KEY=               # Brevo → Settings → SMTP & API → API Keys (xkeysib-…)
MAIL_FROM=info@makilove.de  # отправитель для Brevo (должен быть верифицирован в Brevo)
MAIL_FROM_NAME=MakiLove      # необязательно: отображаемое имя отправителя
MAIL_TO=makilove@hotel-weisses-haus.com    # почта владельца — сюда приходят ПОДТВЕРЖДЁННЫЕ заявки и отписки

# --- Supabase (Waitlist-Status + Consent-Nachweis, Art. 7 DSGVO) ------------
# Источник истины по статусу подписчиков (pending/confirmed/unsubscribed).
# Schema: supabase/schema.sql — выполнить один раз в Supabase SQL Editor.
# Без этих переменных локально используется файловый fallback
# (waitlist-events.jsonl) — на Vercel он НЕ работает (read-only FS).
SUPABASE_URL=                  # Supabase → Project Settings → API → Project URL
SUPABASE_SERVICE_ROLE_KEY=     # service_role key — ТОЛЬКО на сервере, НЕ на клиент!

# --- Secrets (Art. 32 DSGVO) — сгенерировать: openssl rand -base64 32 --------
TOKEN_SECRET=       # HMAC-подпись confirm/unsubscribe-токенов (double-opt-in)
IP_HASH_SECRET=     # HMAC-SHA256-псевдонимизация IP; сырой IP нигде не хранится

# --- Meta (Facebook) Pixel --------------------------------------------------
# ID пикселя из Meta Events Manager. Если пусто — пиксель не грузится вообще
# (ни запросов, ни ошибок). Грузится только после согласия в Cookie-Banner.
NEXT_PUBLIC_FB_PIXEL_ID=

# --- Telegram-Bot (Reservierungen + Kontaktanfragen, Antworten aus dem Bot) ---
# Token von @BotFather. Chat-ID: dem Bot /id schreiben (Gruppe oder privat);
# mehrere Chats mit Komma trennen. Webhook: npm run telegram:setup -- <SITE_URL>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=     # openssl rand -base64 32 — gleicher Wert lokal + Vercel
